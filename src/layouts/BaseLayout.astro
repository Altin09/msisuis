---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { isRTL, getTranslations } from '../i18n/config';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang: string;
  ogImage?: string;
}

const { title, description, lang, ogImage = '/assets/msis-logo-transp-512.png' } = Astro.props;
const t = getTranslations(lang);
const rtl = isRTL(lang);
const dir = rtl ? 'rtl' : 'ltr';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const aiNotice = lang === 'ce' || lang === 'zgh';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang} />
    <meta property="og:site_name" content="MSiS" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Noto+Naskh+Arabic:wght@400;500;700&family=Noto+Sans+Mono&display=swap"
    />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.common.skip}</a>
    <div class="scroll-progress" id="scroll-progress"></div>

    {
      aiNotice && (
        <div class="translation-notice" role="note">
          {t.language_banner.ai_notice}
          <a href="mailto:msis.uis@gmail.com?subject=Translation improvement">
            {t.language_banner.improve}
          </a>
        </div>
      )
    }

    <Nav lang={lang} t={t} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} t={t} />

    <!-- Next-prayer toast -->
    <div
      class="prayer-toast"
      id="prayer-toast"
      role="status"
      aria-live="polite"
      data-begins={t.toast.begins_in}
      data-minutes={t.toast.minutes}
      data-room={t.toast.room}
      data-names={`${t.prayer.fajr}|${t.prayer.dhuhr}|${t.prayer.asr}|${t.prayer.maghrib}|${t.prayer.isha}`}
      hidden
    >
      <span id="prayer-toast-text"></span>
      <button type="button" id="prayer-toast-close" aria-label={t.common.close}>&times;</button>
    </div>

    <script>
      // --- Scroll reveal ---
      const setupReveal = () => {
        const els = document.querySelectorAll('.fade-in');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      };

      // --- Scroll progress bar ---
      const setupProgress = () => {
        const bar = document.getElementById('scroll-progress');
        if (!bar) return;
        const onScroll = () => {
          const h = document.documentElement;
          const scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight || 1);
          bar.style.width = `${Math.min(scrolled * 100, 100)}%`;
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      };

      // --- Next-prayer toast (within 15 min), using Mawaqeet Norge data ---
      const TOAST_ORDER = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'];
      const setupToast = async () => {
        const toast = document.getElementById('prayer-toast');
        const text = document.getElementById('prayer-toast-text');
        const close = document.getElementById('prayer-toast-close');
        if (!toast || !text || !close) return;
        if (sessionStorage.getItem('prayerToastDismissed') === '1') return;
        close.addEventListener('click', () => {
          toast.hidden = true;
          sessionStorage.setItem('prayerToastDismissed', '1');
        });
        try {
          const res = await fetch('/data/prayer-times.json');
          const table = await res.json();
          const now = new Date();
          const pad = (n) => String(n).padStart(2, '0');
          const today = table[`${pad(now.getMonth() + 1)}-${pad(now.getDate())}`];
          if (!today) return;
          const names = (toast.dataset.names || '').split('|');
          TOAST_ORDER.forEach((key, i) => {
            const v = today[key];
            if (!v || !toast.hidden) return;
            const [h, m] = v.split(':').map(Number);
            const when = new Date(now);
            when.setHours(h, m, 0, 0);
            const diffMin = (when.getTime() - now.getTime()) / 60000;
            if (diffMin > 0 && diffMin <= 15) {
              const tpl = toast.dataset;
              text.textContent = `${names[i]} ${tpl.begins} ${Math.round(diffMin)} ${tpl.minutes} — ${tpl.room}`;
              toast.hidden = false;
            }
          });
        } catch (e) {
          /* network failure: silently skip */
        }
      };

      const init = () => {
        setupReveal();
        setupProgress();
        setupToast();
      };
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
