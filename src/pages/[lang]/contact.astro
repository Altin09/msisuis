---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { locales, getTranslations } from '../../i18n/config';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getTranslations(lang!);

const socials = [
  { label: 'Email', value: 'msis.uis@gmail.com', href: 'mailto:msis.uis@gmail.com', icon: 'mail' },
  { label: 'Instagram', value: '@msisuis', href: 'https://instagram.com/msisuis', icon: 'instagram' },
  { label: 'Facebook', value: 'MSIS UiS', href: 'https://facebook.com/', icon: 'facebook' },
  { label: 'WhatsApp', value: 'Community', href: 'https://chat.whatsapp.com/', icon: 'whatsapp' },
];
---

<BaseLayout title={t.meta.contact_title} description={t.meta.contact_desc} lang={lang!}>
  <section class="section">
    <div class="container">
      <Breadcrumb lang={lang!} t={t} label={t.nav.contact} />
    </div>
    <div class="container contact-grid">
      <div class="fade-in">
        <span class="eyebrow">{t.contact.label}</span>
        <h1 class="section-heading">{t.contact.heading}</h1>
        <p class="section-sub">{t.contact.sub}</p>
        <ul class="socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} rel="noopener" target={s.href.startsWith('http') ? '_blank' : undefined}>
                  <span class="social-icon" aria-hidden="true">
                    {s.icon === 'mail' && (
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="M3 7l9 6 9-6" />
                      </svg>
                    )}
                    {s.icon === 'instagram' && (
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                      </svg>
                    )}
                    {s.icon === 'facebook' && (
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M14 8h2V5h-2a3 3 0 00-3 3v2H9v3h2v6h3v-6h2l1-3h-3V8a1 1 0 011-1z" />
                      </svg>
                    )}
                    {s.icon === 'whatsapp' && (
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M21 12a9 9 0 01-13.4 7.9L3 21l1.1-4.6A9 9 0 1121 12z" />
                        <path d="M8.5 8.5c0 4 3 7 7 7" />
                      </svg>
                    )}
                  </span>
                  <span class="social-text">
                    <strong>{s.label}</strong>
                    <span>{s.value}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="card location fade-in">
        <h2 class="loc-heading">{t.contact.location_heading}</h2>
        <p class="loc-text">{t.contact.location_text}</p>
        <iframe
          title={t.contact.location_heading}
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2034.1!2d5.6917!3d58.9690!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTjCsDU4JzA4LjQiTiA1wrA0MSczNS4zIkU!5e0!3m2!1sen!2sno!4v1234567890"
          width="100%"
          height="300"
          style="border:0; border-radius: 14px;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }
  @media (min-width: 880px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .socials {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  .socials a {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    transition: border-color 0.2s ease, transform 0.15s ease;
  }
  .socials a:hover {
    border-color: var(--color-primary-mid);
    transform: translateY(-2px);
  }
  .social-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-light);
    color: var(--color-primary-mid);
    flex: 0 0 auto;
  }
  .social-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .social-text span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .loc-heading {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }
  .loc-text {
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }
</style>
