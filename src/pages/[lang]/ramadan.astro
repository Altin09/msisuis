---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeometricPattern from '../../components/GeometricPattern.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { locales, getTranslations } from '../../i18n/config';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = getTranslations(lang!);

// Approximate Ramadan 1448 AH window. Update each year as needed.
const RAMADAN_START = '2027-02-07';
const RAMADAN_END = '2027-03-08';
---

<BaseLayout title={t.meta.ramadan_title} description={t.meta.ramadan_desc} lang={lang!}>
  <section class="ramadan-hero">
    <GeometricPattern opacity={0.08} color="#f5c842" />
    <div class="container ramadan-hero-inner fade-in">
      <svg class="crescent" viewBox="0 0 120 120" width="96" height="96" aria-hidden="true">
        <defs>
          <mask id="moon-mask">
            <rect width="120" height="120" fill="white" />
            <circle cx="74" cy="56" r="40" fill="black" />
          </mask>
        </defs>
        <circle cx="56" cy="60" r="44" fill="#f5c842" mask="url(#moon-mask)" />
        <g fill="#f5c842">
          <path d="M100 20l2.2 5.2 5.6.5-4.3 3.7 1.3 5.5L100 37.5 95.2 40.4l1.3-5.5-4.3-3.7 5.6-.5z" />
        </g>
      </svg>
      <span class="eyebrow ramadan-eyebrow">{t.ramadan.label}</span>
      <h1 class="ramadan-h1">{t.ramadan.heading}</h1>
      <p class="ramadan-sub">{t.ramadan.sub}</p>
      <p
        class="ramadan-countdown"
        id="ramadan-countdown"
        data-start={RAMADAN_START}
        data-end={RAMADAN_END}
        data-until={t.ramadan.countdown_until}
        data-into={t.ramadan.countdown_into}
        data-over={t.ramadan.countdown_over}
      >
        <span class="rc-num" data-rc-num></span>
        <span class="rc-label" data-rc-label></span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumb lang={lang!} t={t} label={t.ramadan.heading} />
    </div>
    <div class="container ramadan-grid">
      <article class="card fade-in">
        <h2 class="info-heading">{t.ramadan.iftar_heading}</h2>
        <p>{t.ramadan.iftar_text}</p>
      </article>
      <article class="card fade-in">
        <h2 class="info-heading">{t.ramadan.reflection_heading}</h2>
        <p>{t.ramadan.reflection_text}</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .ramadan-hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-bg);
    color: #fff;
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .ramadan-hero-inner {
    position: relative;
    z-index: 1;
  }
  .crescent {
    margin: 0 auto var(--space-md);
  }
  .ramadan-eyebrow {
    color: var(--color-accent);
  }
  .ramadan-h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-sm);
  }
  .ramadan-sub {
    color: #cfe3da;
    max-width: 52ch;
    margin: 0 auto var(--space-lg);
  }
  .ramadan-countdown {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-xl);
  }
  .rc-num {
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }
  .rc-label {
    color: #cfe3da;
    font-size: 0.95rem;
    margin-top: var(--space-xs);
  }
  .ramadan-grid {
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 720px) {
    .ramadan-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .info-heading {
    font-size: 1.2rem;
    color: var(--color-primary-mid);
    margin-bottom: var(--space-sm);
  }
</style>

<script>
  const setupRamadan = () => {
    const el = document.getElementById('ramadan-countdown');
    if (!el) return;
    const numEl = el.querySelector<HTMLElement>('[data-rc-num]');
    const labelEl = el.querySelector<HTMLElement>('[data-rc-label]');
    if (!numEl || !labelEl) return;

    const start = new Date(el.dataset.start + 'T00:00:00');
    const end = new Date(el.dataset.end + 'T23:59:59');
    const now = new Date();
    const DAY = 86400000;

    if (now < start) {
      const days = Math.ceil((start.getTime() - now.getTime()) / DAY);
      numEl.textContent = String(days);
      labelEl.textContent = el.dataset.until ?? '';
    } else if (now <= end) {
      const days = Math.floor((now.getTime() - start.getTime()) / DAY) + 1;
      numEl.textContent = String(days);
      labelEl.textContent = el.dataset.into ?? '';
    } else {
      numEl.textContent = '';
      labelEl.textContent = el.dataset.over ?? '';
    }
  };
  document.addEventListener('astro:page-load', setupRamadan);
</script>
