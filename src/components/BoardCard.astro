---
interface Props {
  initials: string;
  name: string;
  role: string;
  quote: string;
  accentColor?: string;
}
const { initials, name, role, quote, accentColor } = Astro.props;

// Deterministic colour generated from the initials when none is supplied.
function colorFromInitials(s: string): string {
  let hash = 0;
  for (let i = 0; i < s.length; i++) hash = s.charCodeAt(i) + ((hash << 5) - hash);
  const hue = Math.abs(hash) % 360;
  return `hsl(${hue}, 42%, 38%)`;
}
const avatarColor = accentColor ?? colorFromInitials(initials);
// On a light gold accent, dark text reads better than white.
const isLight = accentColor === '#f5c842';
---

<article class="board-card fade-in">
  <div class="avatar" style={`background:${avatarColor};color:${isLight ? '#1a3a1a' : '#fff'}`} aria-hidden="true">
    {initials}
  </div>
  <h3 class="board-name">{name}</h3>
  <p class="board-role">{role}</p>
  <blockquote class="board-quote">“{quote}”</blockquote>
</article>

<style>
  .board-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: var(--space-md);
  }
  .board-name {
    font-size: 1.1rem;
    font-weight: 500;
  }
  .board-role {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-sm);
  }
  .board-quote {
    font-family: var(--font-arabic);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--color-text);
    border-inline-start: 3px solid var(--color-accent);
    padding-inline-start: var(--space-md);
  }
  [dir='ltr'] .board-quote {
    font-family: var(--font-sans);
  }
</style>
