---
// Reusable Islamic 8-pointed star (Khatam) tessellation.
// Rendered as an inline <svg> with a <pattern> tile so it tiles seamlessly.
interface Props {
  opacity?: number;
  color?: string;
  class?: string;
}
const { opacity = 0.07, color = '#ffffff', class: className = '' } = Astro.props;
// A stable id so multiple instances on one page don't collide.
const id = 'geo-' + Math.random().toString(36).slice(2, 9);
---

<svg
  class={`geo-pattern ${className}`}
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
  style={`opacity:${opacity};color:${color}`}
>
  <defs>
    <pattern id={id} width="80" height="80" patternUnits="userSpaceOnUse">
      <!-- Tile is 80x80; geometry centred on (40,40). -->
      <g fill="none" stroke="currentColor" stroke-width="1.1">
        <!-- Outer octagon -->
        <polygon
          points="40,6 64,16 74,40 64,64 40,74 16,64 6,40 16,16"
        ></polygon>
        <!-- 8-pointed star: two interlaced squares -->
        <polygon points="40,12 68,40 40,68 12,40"></polygon>
        <polygon points="20,20 60,20 60,60 20,60"></polygon>
        <!-- Girih intersection lines through midpoints -->
        <line x1="40" y1="6" x2="40" y2="74"></line>
        <line x1="6" y1="40" x2="74" y2="40"></line>
        <line x1="16" y1="16" x2="64" y2="64"></line>
        <line x1="64" y1="16" x2="16" y2="64"></line>
        <circle cx="40" cy="40" r="6"></circle>
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

<style>
  .geo-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: currentColor;
  }
</style>
