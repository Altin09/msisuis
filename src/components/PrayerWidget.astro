---
interface Props {
  t: Record<string, any>;
  full?: boolean;
}
const { t, full = false } = Astro.props;

// Data key -> translation label. Sunrise only shown in full mode.
const rows = [
  { key: 'fajr', label: t.prayer.fajr, prayer: true },
  { key: 'sunrise', label: t.prayer.sunrise, prayer: false, fullOnly: true },
  { key: 'dhuhr', label: t.prayer.dhuhr, prayer: true },
  { key: 'asr', label: t.prayer.asr, prayer: true },
  { key: 'maghrib', label: t.prayer.maghrib, prayer: true },
  { key: 'isha', label: t.prayer.isha, prayer: true },
].filter((r) => (full ? true : !r.fullOnly));
---

<div
  class={`prayer-widget ${full ? 'prayer-widget--full' : 'prayer-widget--card'}`}
  data-prayer
  data-next-label={t.prayer_widget.next}
>
  <div class="pw-head">
    <p class="pw-title">{full ? t.prayer.heading : t.prayer_widget.title}</p>
    <p class="pw-dates">
      <span class="pw-hijri" data-hijri>—</span>
      <span class="pw-date" data-date></span>
    </p>
  </div>

  {
    full && (
      <p class="pw-countdown" data-countdown>
        <span class="pw-countdown-label">{t.prayer.countdown_label}</span>
        <span class="pw-countdown-value" data-countdown-value>—</span>
      </p>
    )
  }

  <ul class="pw-list">
    {
      rows.map((r) => (
        <li class="pw-row" data-prayer-row={r.prayer ? r.key : undefined}>
          <span class="pw-name">{r.label}</span>
          <span class="pw-time" data-time={r.key}>
            <span class="skeleton skeleton-time" />
          </span>
        </li>
      ))
    }
  </ul>

  <p class="pw-extreme" data-extreme hidden>{t.prayer.extreme_isha}</p>

  <p class="pw-footer">
    {t.prayer.powered_by} <strong>{t.prayer.source}</strong> · {t.prayer.location}
  </p>
</div>

<style>
  .prayer-widget {
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }
  .prayer-widget--card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    width: 100%;
    max-width: 340px;
    backdrop-filter: blur(6px);
  }
  .prayer-widget--full {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }
  .pw-head {
    margin-bottom: var(--space-md);
  }
  .pw-title {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }
  .pw-dates {
    font-size: 0.85rem;
    margin-top: 2px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em;
  }
  .pw-hijri {
    opacity: 0.9;
    font-weight: 500;
  }
  .pw-date {
    opacity: 0.65;
    font-variant-numeric: tabular-nums;
  }
  .pw-date:not(:empty)::before {
    content: '·';
    margin-inline-end: 0.4em;
    opacity: 0.6;
  }
  .pw-countdown {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    background: var(--color-primary-light);
    color: var(--color-primary-mid);
    border-radius: var(--radius-md);
    padding: 0.6rem var(--space-md);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }
  .pw-countdown-value {
    font-variant-numeric: tabular-nums;
    font-size: 1.1rem;
  }
  .pw-list {
    display: flex;
    flex-direction: column;
  }
  .pw-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius-sm);
    border-bottom: 1px solid currentColor;
    border-color: var(--color-border);
  }
  .prayer-widget--card .pw-row {
    border-color: rgba(255, 255, 255, 0.1);
  }
  .pw-row:last-child {
    border-bottom: 0;
  }
  .pw-row.is-next {
    background: rgba(245, 200, 66, 0.16);
    color: var(--color-accent);
    font-weight: 600;
  }
  .prayer-widget--full .pw-row.is-next {
    color: var(--color-accent-dark);
    background: rgba(245, 200, 66, 0.22);
  }
  .pw-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .pw-row.is-next .pw-name::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.5);
    }
  }
  .pw-time {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .pw-next-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-inline-start: var(--space-sm);
  }
  .pw-extreme {
    margin-top: var(--space-md);
    font-size: 0.82rem;
    line-height: 1.55;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    border-inline-start: 3px solid var(--color-accent);
  }
  .prayer-widget--card .pw-extreme {
    background: rgba(245, 200, 66, 0.12);
    color: #f3e6c0;
  }
  .prayer-widget--full .pw-extreme {
    background: var(--color-primary-light);
    color: var(--color-text-muted);
  }
  .pw-extreme[hidden] {
    display: none;
  }
  .pw-footer {
    margin-top: var(--space-md);
    font-size: 0.75rem;
    opacity: 0.7;
  }
  /* Loading skeletons */
  .skeleton {
    display: inline-block;
    border-radius: 4px;
    background: linear-gradient(
      90deg,
      rgba(128, 128, 128, 0.15) 25%,
      rgba(128, 128, 128, 0.28) 37%,
      rgba(128, 128, 128, 0.15) 63%
    );
    background-size: 400% 100%;
    animation: shimmer 1.4s ease infinite;
  }
  .skeleton-time {
    width: 48px;
    height: 14px;
  }
  @keyframes shimmer {
    0% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0 50%;
    }
  }
</style>

<script>
  // Prayers in daily order (Sunrise excluded — it is not a prayer time).
  const PRAYER_ORDER = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'];

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }
  function mmdd(d: Date): string {
    return `${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  }
  function fmtDate(d: Date): string {
    return `${pad(d.getDate())}.${pad(d.getMonth() + 1)}.${d.getFullYear()}`;
  }
  // Islamic (Umm al-Qura) date from the system clock — no API needed.
  function fmtHijri(d: Date): string {
    const pageLang = document.documentElement.lang || 'en';
    const loc = pageLang === 'en' ? 'en-GB' : pageLang; // en-GB = day-first
    const opts: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
    try {
      return new Intl.DateTimeFormat(`${loc}-u-ca-islamic-umalqura`, opts).format(d);
    } catch {
      return new Intl.DateTimeFormat('en-GB-u-ca-islamic-umalqura', opts).format(d);
    }
  }
  function toToday(hhmm: string): Date {
    const [h, m] = hhmm.split(':').map(Number);
    const d = new Date();
    d.setHours(h, m, 0, 0);
    return d;
  }
  function fmtCountdown(ms: number): string {
    const total = Math.max(0, Math.floor(ms / 1000));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    return `${pad(h)}:${pad(m)}:${pad(s)}`;
  }

  type DayTimes = Record<string, string | null>;

  async function initPrayerWidgets() {
    const widgets = document.querySelectorAll<HTMLElement>('[data-prayer]');
    if (!widgets.length) return;

    let table: Record<string, DayTimes>;
    try {
      const res = await fetch('/data/prayer-times.json');
      table = await res.json();
    } catch {
      widgets.forEach((w) => {
        const dd = w.querySelector('[data-date]');
        if (dd) dd.textContent = '—';
      });
      return;
    }

    const now = new Date();
    const today = table[mmdd(now)];
    if (!today) return;

    // Determine next prayer (skip Isha when it has no time during extreme period).
    let nextKey: string | null = null;
    let nextTime: Date | null = null;
    for (const k of PRAYER_ORDER) {
      const v = today[k];
      if (!v) continue;
      const when = toToday(v);
      if (when > now) {
        nextKey = k;
        nextTime = when;
        break;
      }
    }
    // Past all of today's prayers → tomorrow's Fajr.
    if (!nextKey) {
      const tmr = new Date(now);
      tmr.setDate(tmr.getDate() + 1);
      const tdata = table[mmdd(tmr)];
      if (tdata?.fajr) {
        nextKey = 'fajr';
        const [h, m] = tdata.fajr.split(':').map(Number);
        nextTime = new Date(tmr);
        nextTime.setHours(h, m, 0, 0);
      }
    }

    const ishaMissing = !today.isha;

    widgets.forEach((w) => {
      const dd = w.querySelector('[data-date]');
      if (dd) dd.textContent = fmtDate(now);
      const hj = w.querySelector('[data-hijri]');
      if (hj) hj.textContent = fmtHijri(now);

      w.querySelectorAll<HTMLElement>('[data-time]').forEach((el) => {
        const key = el.dataset.time!;
        el.textContent = today[key] ?? '--:--';
      });

      // Highlight next prayer + badge.
      if (nextKey) {
        const row = w.querySelector<HTMLElement>(`[data-prayer-row="${nextKey}"]`);
        if (row) {
          row.classList.add('is-next');
          const badge = document.createElement('span');
          badge.className = 'pw-next-badge';
          badge.textContent = w.dataset.nextLabel ?? 'Next';
          row.querySelector('.pw-name')?.appendChild(badge);
        }
      }

      // Extreme-period Isha notice.
      const ex = w.querySelector<HTMLElement>('[data-extreme]');
      if (ex && ishaMissing) ex.hidden = false;

      // Countdown (full mode only).
      const cdVal = w.querySelector<HTMLElement>('[data-countdown-value]');
      if (cdVal && nextTime) {
        const target = nextTime;
        const tick = () => {
          cdVal.textContent = fmtCountdown(target.getTime() - Date.now());
        };
        tick();
        const id = window.setInterval(tick, 1000);
        document.addEventListener('astro:before-swap', () => window.clearInterval(id), {
          once: true,
        });
      }
    });
  }

  document.addEventListener('astro:page-load', initPrayerWidgets);
</script>
